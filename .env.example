# =============================================================================
# ZeeNoodle settings
# Order does not matter. Do not commit this file or share tokens in chat.
# =============================================================================

# --- Required Discord ---
# Bot token from the Discord Developer Portal (Bot tab). Keep secret.
DISCORD_TOKEN=

# Channel ID where delete reports are posted (#bot-incendents).
INCIDENT_CHANNEL_ID=1547016477104672798

# Character that starts staff commands (example: ! or ^). Do not use /.
COMMAND_PREFIX=!

# --- Detection ---
# How close an image must be to a reference to count as a match (default 10).
HASH_DISTANCE=10

# Same content in 2+ channels within this many seconds triggers a cross-post check.
CROSSPOST_SECONDS=120

# Hours after a warning before another scam delete can auto-kick (default 24).
# You can also change this in Discord with: ^kickwindow 24
KICK_WINDOW_HOURS=24

# --- Hosting (optional) ---
# Persistent data folder on the host. Leave blank on Waifly unless you have a volume path.
DATA_DIR=

# Hosting panel URL. Used by ^hostlink (DM only).
HOST_URL=

# --- GitHub backup (optional) ---
# Your repo URL only. Leave blank if you are not using GitHub backup.
GITHUB_REMOTE=

# Personal access token with repo scope. Keep secret.
GITHUB_TOKEN=

# Branch for backup data (use data, not main, so code pushes do not wipe backups).
GITHUB_BRANCH=data

# --- Updates (optional) ---
# Raw GitHub base URL for ^update. Leave blank to use the official ZeeNoodle repo.
UPDATE_REPO=

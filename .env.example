# =============================================================================
# ZeeNoodle settings
# =============================================================================

# --- Required Discord ---

# Bot token from the Discord Developer Portal (Bot tab → Reset/Copy Token).
# This is the secret login key that lets ZeeNoodle connect to Discord.
DISCORD_TOKEN=

# Numeric channel ID for staff reports (right-click channel → Copy Channel ID).
# When ZeeNoodle deletes a scam message, it posts the incident here.
INCIDENT_CHANNEL_ID=1547016477104672798

# Character(s) that start staff commands in Discord (examples: ! or ^).
# Do not use /. Change later with ^zeenoodletrigger if needed.
COMMAND_PREFIX=!

# --- Detection ---

# How loosely images can match a reference screenshot (0 = almost exact).
# Higher = more matches (and more false positives). Default 10 works well.
HASH_DISTANCE=10

# If the same image/text from one user appears in this many seconds across
# 2+ channels, ZeeNoodle treats it as a cross-post and runs the spam filters.
CROSSPOST_SECONDS=120

# After a warning DM, how many hours the auto-kick window stays open.
# Another scam delete inside this window can kick the user. Default 24.
# Change in Discord with: ^kickwindow 24
KICK_WINDOW_HOURS=24

# --- Hosting (optional) ---

# Folder where live data is stored (references, ignore list, stats.db).
# Waifly: leave blank — data stays next to bot.py in /home/container.
# Quaxly (or similar): if the panel shows a volume/mount path, paste it here
# so pictures and config survive redeploys. Example: /data
DATA_DIR=

# URL of your hosting control panel (Waifly/Quaxly server page).
# Used only by ^hostlink, which DMs the link to the admin who ran it.
HOST_URL=

# --- GitHub backup (optional) ---

# Your GitHub repo URL for saving pictures, ignore list, and stats.
# Use a repo you own. Leave blank if you are not using GitHub backup.
GITHUB_REMOTE=

# GitHub Personal Access Token with "repo" scope.
# Lets the bot push/pull backups. Keep this secret like the Discord token.
GITHUB_TOKEN=

# Git branch used for backup data (pictures, config, stats).
# Use "data" (not "main") so code updates do not overwrite your backups.
GITHUB_BRANCH=data

# --- Updates (optional) ---

# Raw GitHub base URL that ^update downloads new bot code from.
# Official ZeeNoodle repo (leave as-is unless you use a fork):
UPDATE_REPO=https://raw.githubusercontent.com/Zephino/ZeeNoodle/main
